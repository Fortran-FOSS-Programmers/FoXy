$ solver
coupled -> prefix "", local "coupled", namespace "https://example.org/flow"
case -> prefix "", local "case", namespace "https://example.org/flow"
dt -> prefix "", local "dt", namespace "https://example.org/flow"
th:case -> prefix "th", local "case", namespace "https://example.org/thermal"
th:dt -> prefix "th", local "dt", namespace "https://example.org/thermal"
conductivity -> prefix "", local "conductivity", namespace "https://example.org/materials"
thermal dt: 5.0e-3
flow dt:    1.0e-3
k:          237.0
literal "dt" matches: 1
