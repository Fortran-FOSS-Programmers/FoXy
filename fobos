[project]
name       = FoXy
version    = VERSION
summary    = Fortran XML parser for poor people
repository = https://github.com/Fortran-FOSS-Programmers/FoXy
website    = https://fortran-foss-programmers.github.io/FoXy/
email      = stefano.zaghi@gmail.it
authors    = Stefano Zaghi

[dependencies]
deps_dir   = src/third_party
BeFoR64    = https://github.com/szaghi/BeFoR64
FACE       = https://github.com/szaghi/FACE
PENF       = https://github.com/szaghi/PENF
StringiFor = https://github.com/szaghi/StringiFor

[modes]
modes = tests-gnu
        tests-gnu-debug
        tests-intel
        tests-intel-debug
        tests-nvidia
        tests-nvidia-debug
        benchmark-gnu
        benchmark-gnu-profile

[common-variables]
$CSHARED_GNU = -DGNU -cpp -c -fPIC -frealloc-lhs
$CSHARED_INT = -cpp -c -fpic -assume realloc_lhs
$LSHARED     = -shared
$CSTATIC_GNU = -DGNU -cpp -c -frealloc-lhs
$CSTATIC_INT = -cpp -c -assume realloc_lhs -heap-arrays
$DEBUG_GNU   = -DGNU -O0 -g3 -Warray-bounds -Wcharacter-truncation -Wline-truncation -Wimplicit-interface -Wimplicit-procedure -Wunderflow -fmodule-private -ffree-line-length-132 -fimplicit-none -fbacktrace -fdump-core -finit-real=nan -std=f2018 -fall-intrinsics
$DEBUG_INT   = -O0 -debug all -check all -warn all -extend-source 132 -traceback -gen-interfaces -fpe-all=0 -fstack-protector-all -ftrapuv -no-ftz -std08
$CSTATIC_NV  = -Mpreprocess -c
$DEBUG_NV    = -O0 -g -C -traceback -Minform=warn -Mstandard
$OPTIMIZE    = -O2
$PROFILE     = -pg
$BENCHSRC    = ./src/lib/ ./src/third_party/ ./benchmarks/
$EXDIRS      = BeFoR64/src/tests/ FACE/src/tests/ PENF/src/tests/ StringiFor/src/tests/ BeFoR64/docs/ FACE/docs/ PENF/docs/ PENF/scripts/ StringiFor/docs/

# main modes
# GNU
[tests-gnu]
template  = template-static-gnu
build_dir = exe

[tests-gnu-debug]
template  = template-static-gnu-debug
build_dir = exe

# Intel
[tests-intel]
template  = template-static-intel
build_dir = exe

[tests-intel-debug]
template  = template-static-intel-debug
build_dir = exe

# NVIDIA
[tests-nvidia]
template  = template-static-nvidia
build_dir = exe

[tests-nvidia-debug]
template  = template-static-nvidia-debug
build_dir = exe

# benchmarks (out of src/: never built as tests); usage in benchmarks/foxy_benchmark_parse.f90
[benchmark-gnu]
template  = template-static-gnu
build_dir = exe/benchmarks
src       = $BENCHSRC

[benchmark-gnu-profile]
template  = template-static-gnu
build_dir = exe/benchmarks-profile
src       = $BENCHSRC
cflags    = $CSTATIC_GNU $OPTIMIZE $PROFILE
lflags    = $OPTIMIZE $PROFILE

#templates
[template-static-gnu]
compiler        = gnu
cflags          = $CSTATIC_GNU $OPTIMIZE
cflags_heritage = True
exclude_dirs    = $EXDIRS
mod_dir         = ./mod/
obj_dir         = ./obj/
src             = ./src/
colors          = True
quiet           = False
log             = True
jobs            = 10

[template-static-gnu-debug]
compiler        = gnu
cflags          = $CSTATIC_GNU $DEBUG_GNU
lflags          = $DEBUG_GNU
cflags_heritage = True
exclude_dirs    = $EXDIRS
mod_dir         = ./mod/
obj_dir         = ./obj/
src             = ./src/
colors          = True
quiet           = False
log             = True
jobs            = 10

[template-static-intel]
compiler        = intel
fc              = ifx
cflags          = $CSTATIC_INT $OPTIMIZE
lflags          = $OPTIMIZE
cflags_heritage = True
exclude_dirs    = $EXDIRS
mod_dir         = ./mod/
obj_dir         = ./obj/
src             = ./src/
colors          = True
quiet           = False
log             = True
jobs            = 10

[template-static-intel-debug]
compiler        = intel
fc              = ifx
cflags          = $CSTATIC_INT $DEBUG_INT
lflags          = $DEBUG_INT
cflags_heritage = True
exclude_dirs    = $EXDIRS
mod_dir         = ./mod/
obj_dir         = ./obj/
src             = ./src/
colors          = True
quiet           = False
log             = True
jobs            = 10

[template-static-nvidia]
compiler        = nvfortran
cflags          = $CSTATIC_NV $OPTIMIZE
lflags          = $OPTIMIZE
cflags_heritage = True
exclude_dirs    = $EXDIRS
mod_dir         = ./mod/
obj_dir         = ./obj/
src             = ./src/
colors          = True
quiet           = False
log             = True
jobs            = 10

[template-static-nvidia-debug]
compiler        = nvfortran
cflags          = $CSTATIC_NV $DEBUG_NV
lflags          = $DEBUG_NV
cflags_heritage = True
exclude_dirs    = $EXDIRS
mod_dir         = ./mod/
obj_dir         = ./obj/
src             = ./src/
colors          = True
quiet           = False
log             = True
jobs            = 10

[rule-makedoc]
help   = Build documentation with formal + VitePress
rule_1 = formal generate --mirror-sources --diagrams --project docs/ford.md --output docs/api
rule_2 = cd docs && npm ci && npm run docs:build

[rule-deldoc]
help = Delete documentation build artifacts
rule = rm -rf docs/.vitepress/dist/ docs/.vitepress/cache/ docs/api/

[rule-maketar]
help = Rule for making tar archive of the project
rule = tar --xform="s%^%FoXy/%" -czf FoXy.tar.gz *

[rule-makecoverage]
help   = Rule for performing coverage analysis
rule_1 = fobis clean --mode tests-gnu-debug
rule_2 = fobis build --mode tests-gnu-debug --coverage
rule_3 = ./scripts/run_tests.sh
rule_4 = rm -f exe/obj/befor64* exe/obj/face* exe/obj/penf* exe/obj/stringifor*
rule_5 = ./scripts/compute-coverage.sh

[rule-makecoverage-analysis]
help   = Rule for performing coverage analysis and saving reports in markdown
rule_1 = fobis rule --ex makecoverage
rule_2 = fobis rule --gcov-analyzer docs/guide/ --gcov-analyzer coverage-analysis
rule_3 = rm -f *.gcov
